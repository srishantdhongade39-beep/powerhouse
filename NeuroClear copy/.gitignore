# ===== NeuroClear (SEC086) - .gitignore =====
# NOTE: Patient data and large CT datasets must NEVER be committed.

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ----- Virtual environments -----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ----- IDE / editor configuration -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Environment / secrets -----
.env
.env.*
*.env
secrets.toml
.streamlit/secrets.toml
*.pem
*.key

# ----- Testing / coverage -----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- Generated outputs -----
outputs/
output/
results/
*.log
*.tmp

# ----- DICOM files and large medical datasets (NEVER commit patient data) -----
*.dcm
*.dicom
*.ima
*.nii
*.nii.gz
data/*
!data/.gitkeep

# ----- Large / binary datasets -----
*.zip
*.tar
*.tar.gz
*.7z
*.npy
*.npz
